# Microsoft Bot Framework Configuration
BOT_ID=your-azure-bot-app-id
BOT_PASSWORD=your-azure-bot-app-password
BOT_TENANT_ID=your-azure-ad-tenant-id
PORT=3978
PUBLIC_BASE_URL=https://your-devtunnel-url.inc1.devtunnels.ms

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Enterprise Policy Configuration
MAX_MEAL_LIMIT_PER_PERSON=75.0
MAX_UNAPPROVED_PURCHASE_AMOUNT=1000.0
RESTRICT_ALCOHOL=true
ALLOW_FOREIGN_CURRENCY=true

# Server Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
